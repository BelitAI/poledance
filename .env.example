# Credenciales de ejemplo para MongoDB
MONGO_USER=usuario_ejemplo
MONGO_PASSWORD=contrasena_ejemplo
MONGO_DB=poledance

# Conexión desde el ordenador
# Docker Compose usa el nombre "mongo" para la API dentro del contenedor.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin

# Clave de ejemplo para firmar tokens
JWT_SECRET=cambia_esta_clave_por_una_propia